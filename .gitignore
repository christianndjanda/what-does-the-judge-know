__pycache__/
*.py[cod]
.venv/
venv/
.env

# Data and artefacts are regenerable, and large -- with two exceptions. The Phase 0
# result files (gate reports, diagnostics, the transcripts they were computed on)
# are the evidence behind the writeup, they are small, and they cannot be
# reproduced once the GPU instance is terminated. So they are tracked; the
# activation caches, which are large and regenerable, are not.
#
# The Phase 2 corpus is tracked for the same reason and one stronger: it is 210KB,
# it cost $2.15 of API spend, and it was generated at temperature 1.0, so it is not
# reproducible even by rerunning the same command with the same seed. Losing it
# would mean regenerating a *different* corpus, which would invalidate every number
# already computed against this one.
data/*
!data/phase0/
data/phase0/*
!data/phase0/*.json
!data/phase0/*.jsonl
!data/phase0/archive/
data/phase0/archive/*
!data/phase0/archive/*.json
!data/phase0/archive/*.md
!data/phase1/
data/phase1/*
!data/phase1/*.json
!data/phase2/
data/phase2/*
!data/phase2/*.json
!data/phase2/*.jsonl
# Per-run subdirectories (acts/, acts_v2/, acts_rounds/) hold the reports AND the
# per-debate verdict records; only the activation caches are large. The rules above
# reach one level only, so these files had to be force-added one at a time -- which is
# exactly how acts_rounds/verdicts.json ended up untracked while every sibling in the
# same directory was committed, silently breaking reproduction from a fresh clone.
# Re-include the directories, then their JSON; *.npy below still wins over both.
!data/phase2/*/
data/phase2/*/*
!data/phase2/*/*.json
!data/phase2/*/*.jsonl
# A throwaway CPU smoke run. Not evidence, and not worth the noise.
data/phase2/acts_cpu_smoke/
logs/
out/

*.npy
*.npz
*.safetensors
